{
  "name": "dsh-llm-cli",
  "version": "0.7.2",
  "description": "Model routes for DeepSeek Harness served by installed OpenCode, Grok and Codex CLIs, with model limits, session workspaces, tools, image attachments, streaming replies and a dashboard of recorded CLI usage and quota snapshots",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "llm",
    "cli",
    "opencode",
    "grok",
    "codex"
  ],
  "license": "MIT",
  "author": "Mans230 (https://github.com/Mans230)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mans230/dsh-llm-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Mans230/dsh-llm-cli/issues"
  },
  "homepage": "https://github.com/Mans230/dsh-llm-cli#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:ui": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dom18": "npm:react-dom@18.3.1",
    "react-is": "^19.3.1",
    "react18": "npm:react@18.3.1",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  }
}
