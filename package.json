{
  "name": "dsh-llm-cli",
  "version": "0.7.1",
  "description": "Model routes for DeepSeek Harness served by installed OpenCode, Grok and Codex CLIs, with model limits, session workspaces, tools, image attachments, streaming replies and a dashboard of recorded CLI usage and quota snapshots",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "llm",
    "cli",
    "opencode",
    "grok",
    "codex"
  ],
  "license": "MIT",
  "author": "Mans230 (https://github.com/Mans230)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mans230/dsh-llm-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Mans230/dsh-llm-cli/issues"
  },
  "homepage": "https://github.com/Mans230/dsh-llm-cli#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*"
  }
}
